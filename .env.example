# Repo-level tunables, read hot via lead.common.dotenv
# Every access re-reads this file, so edits apply to running jobs immediately).
# Copy to .env for local overrides: cp .env.example .env

# --- Machine-local config ---
# Absolute path to the CARLA installation (the directory containing CarlaUE4.sh)
CARLA_ROOT=<LEAD directory>/3rd_party/CARLA/standard_0916
# Default leaderboard/scenario_runner put on sys.path by lead/__init__.py
# (evaluation subprocesses override them via PYTHONPATH)
LEADERBOARD_ROOT=<LEAD directory>/3rd_party/leaderboard/expert/leaderboard
SCENARIO_RUNNER_ROOT=<LEAD directory>/3rd_party/leaderboard/expert/scenario_runner
# PY123D PATH
PY123D_DATA_ROOT=<LEAD directory>/data/LEAD
# Root directory for generated outputs (checkpoints, evaluation results, logs)
LEAD_OUTPUT_DIR_ROOT=<LEAD directory>/outputs


# --- SLURM: configs when run individual jobs ---
# SLURM partition jobs submit to
SLURM_PARTITION=a100-galvani
# Email SLURM sends job notifications to (--mail-user)
SLURM_EMAIL_USER=you@example.com

# --- SLURM: configs when run mass evaluations or data collection ---
MAX_NUM_ATTEMPTS_BENCH2DRIVE=3
MAX_NUM_ATTEMPTS_COLLECT_DATA=2
MAX_NUM_ATTEMPTS_FAIL2DRIVE=6
MAX_NUM_ATTEMPTS_LONGEST6=3
MAX_NUM_ATTEMPTS_TOWN13=3

MAX_NUM_PARALLEL_JOBS_BENCH2DRIVE=16
MAX_NUM_PARALLEL_JOBS_COLLECT_DATA=80
MAX_NUM_PARALLEL_JOBS_FAIL2DRIVE=92
MAX_NUM_PARALLEL_JOBS_LONGEST6=8
MAX_NUM_PARALLEL_JOBS_TOWN13=20

COLLECT_DATA_PARTITION=day
COLLECT_DATA_CPUS_PER_TASK=2
COLLECT_DATA_MEM=40gb
COLLECT_DATA_GRES=gpu:1080ti:1
COLLECT_DATA_TIMEOUT=300

# Seconds per attempt to wait for the CARLA server to serve RPC calls
COLLECT_DATA_CARLA_BOOT_TIMEOUT=60
# CARLA start attempts per job; each retry uses fresh random ports
COLLECT_DATA_CARLA_BOOT_ATTEMPTS=5

# --- WandB logging intervals during training (gradient steps) ---
WANDB_LOG_FREQUENCY_TRAINING_IMAGES=5000
WANDB_LOG_FREQUENCY_TRAINING_SCALAR=50

# Toggle runtime type checking (for debugging).
# If 1, will check types of all function arguments and return values at runtime.
# If 0, will skip these checks for speed.
LEAD_RUNTIME_TYPE_CHECKING=0
